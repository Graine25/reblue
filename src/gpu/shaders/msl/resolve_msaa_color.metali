#pragma once

#include "copy_common.metali"

// Multisampled source bound at the same bindless slot as the non-MS heap;
// plume creates the multisample view when the source texture's sampleCount > 1.
// Metal carries the sample count on the texture rather than in the type, so
// SAMPLE_COUNT here only fixes the unrolled averaging loop, matching the
// Texture2DMS<float4, SAMPLE_COUNT> the HLSL declares.
struct Texture2DMSDescriptorHeap {
    texture2d_ms<float> tex;
};

[[fragment]]
float4 shaderMain(FullscreenVaryings input [[stage_in]],
                  constant Texture2DMSDescriptorHeap* textureHeap [[buffer(0)]],
                  constant CopyPushConstants& push [[buffer(8)]]) {
    texture2d_ms<float> tex = textureHeap[push.resourceDescriptorIndex].tex;
    const uint2 dimensions{tex.get_width(), tex.get_height()};
    // Map this destination pixel to the (smaller) MS source texel, then average
    // that texel's N samples. Point-stretch; the present-time FSR pass does the
    // high-quality upscale.
    const uint2 coord = min(uint2(input.texCoord * float2(dimensions)),
                            dimensions - uint2(1));
    float4 result = tex.read(coord, 0);
    for (uint i = 1; i < SAMPLE_COUNT; ++i)
        result += tex.read(coord, i);
    result /= float(SAMPLE_COUNT);
    // param0 = the X360 resolve exponent-bias scale (2^bias). Must be applied
    // exactly as copy_color_ps does, or BD's HDR scene (bias=-2, x0.25) stays
    // 4x too bright and the posteff blows the frame white. Force alpha=1.
    return float4(result.rgb * push.param0, 1.0);
}
